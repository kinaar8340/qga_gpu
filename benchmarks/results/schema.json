{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qga-gpu-bench BenchRecord",
  "description": "Software fact of one qga-gpu-bench run. Not a proof of inner_cone mosaic or qga-app cosmos.",
  "type": "object",
  "required": [
    "gitsha",
    "preset",
    "width",
    "height",
    "fibers",
    "fiber_samples",
    "particles",
    "orbs",
    "frames",
    "glow",
    "dirty_particles",
    "dirty_fibers",
    "multiply",
    "ms_wall",
    "ms_mean",
    "ms_min",
    "ms_max",
    "hz",
    "write_buffer_calls",
    "ring_copies",
    "static_uploads",
    "static_skipped",
    "live_skipped",
    "particle_skipped",
    "particle_grows",
    "particle_fallbacks",
    "fiber_reallocs",
    "vram_estimate_bytes",
    "claims"
  ],
  "properties": {
    "gitsha": { "type": "string" },
    "preset": { "type": "string", "enum": ["smoke", "ring-qga", "4090", "soak"] },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "fibers": { "type": "integer" },
    "fiber_samples": { "type": "integer" },
    "particles": { "type": "integer" },
    "orbs": { "type": "integer" },
    "frames": { "type": "integer" },
    "glow": { "type": "boolean" },
    "dirty_particles": { "type": "boolean" },
    "dirty_fibers": { "type": "boolean" },
    "multiply": { "type": "string", "enum": ["left", "right"] },
    "tube_radius": { "type": "number" },
    "ms_wall": { "type": "number" },
    "ms_mean": { "type": "number" },
    "ms_min": { "type": "number" },
    "ms_max": { "type": "number" },
    "hz": { "type": "number" },
    "write_buffer_calls": { "type": "integer" },
    "ring_copies": { "type": "integer" },
    "static_uploads": { "type": "integer" },
    "static_skipped": { "type": "integer" },
    "live_fiber_writes": { "type": "integer" },
    "live_skipped": { "type": "integer" },
    "particle_skipped": { "type": "integer" },
    "particle_grows": { "type": "integer" },
    "particle_fallbacks": { "type": "integer" },
    "fiber_reallocs": { "type": "integer" },
    "vram_estimate_bytes": { "type": "integer" },
    "capture_bytes": { "type": "integer" },
    "claims": { "type": "string", "const": "Software fact" },
    "not_a_proof_of": { "type": "string" }
  }
}
